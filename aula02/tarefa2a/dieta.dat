    cenoura      0.60
    couve        0.80
    laranja      0.70;

param a:
             calorias proteina calcio sodio  ferro  vitamina_A vitamina_C vitamina_B1 :=
arroz           128      2.5   0.005 0.001 0.0003       0        0.0       0.16
